# Local development template. Copy to `.env` and adjust.
# Never commit real production credentials.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (matches docker-compose.yml local defaults)
DATABASE_URL=postgresql://mgmt:mgmt_dev_only@localhost:5432/management_platform?schema=public

# DEV-ONLY authentication bridge.
# Production must leave these unset/false. The app fails closed without a real principal.
# ALLOW_DEV_AUTH is ignored unless NODE_ENV=development.
ALLOW_DEV_AUTH=true

# Developer-generated UUID for the local principal. Do NOT use a personal email.
# Example generation: `node -e "console.log(require('crypto').randomUUID())"`
DEV_AUTH_PRINCIPAL_ID=

# Optional display label for the DEV principal (not an email identity).
DEV_AUTH_DISPLAY_NAME=Local Developer
