# Local development template. Copy to `.env` and adjust.
# Never commit real production credentials.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
# Auth.js canonical URL (defaults to APP_URL when unset)
# AUTH_URL=http://localhost:3000

# PostgreSQL (matches docker-compose.yml local defaults)
DATABASE_URL=postgresql://mgmt:mgmt_dev_only@localhost:5432/management_platform?schema=public
# Direct (non-pooled) URL for Prisma migrations. Locally same as DATABASE_URL.
DIRECT_URL=postgresql://mgmt:mgmt_dev_only@localhost:5432/management_platform?schema=public

# DEV-ONLY authentication bridge.
# Production must leave these unset/false. The app fails closed without a real principal.
# ALLOW_DEV_AUTH is ignored unless NODE_ENV=development. Production forbids ALLOW_DEV_AUTH=true.
ALLOW_DEV_AUTH=true

# Developer-generated UUID for the local principal. Do NOT use a personal email.
# Example generation: `node -e "console.log(require('crypto').randomUUID())"`
DEV_AUTH_PRINCIPAL_ID=

# Optional display label for the DEV principal (not an email identity).
DEV_AUTH_DISPLAY_NAME=Local Developer

# --- Production OIDC (Auth.js) — optional locally; required for production SSO ---
# AUTH_SECRET=generate-with-openssl-rand-base64-32
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# One-time bootstrap token (min 16 chars). Consume via /setup/bootstrap after first OIDC login.
# BOOTSTRAP_SETUP_TOKEN=
