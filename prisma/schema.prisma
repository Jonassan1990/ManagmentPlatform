/// Project conversion is idempotent via unique initiativeId — never fork history.
model Project {
  id              String          @id @default(uuid()) @db.Uuid
  initiativeId    String          @unique @db.Uuid
  organizationId  String          @db.Uuid
  referenceKey    String          @db.VarChar(40)
  name            String          @db.VarChar(300)
  description     String?         @db.VarChar(8000)
  /// Free-text business owner — not a Principal FK.
  ownerName       String?         @db.VarChar(200)
  departmentId    String          @db.Uuid
  status          ProjectStatus   @default(ACTIVE)
  priority        ProjectPriority @default(MEDIUM)
  plannedStart    DateTime?
  plannedEnd      DateTime?
  estimatedCost   Decimal?        @db.Decimal(18, 2)
  approvedBudget  Decimal?        @db.Decimal(18, 2)
  plannedCost     Decimal?        @db.Decimal(18, 2)
  forecastCost    Decimal?        @db.Decimal(18, 2)
  actualCost      Decimal?        @db.Decimal(18, 2)
  currencyCode    String          @default("EUR") @db.VarChar(3)
  objectives      String?         @db.VarChar(8000)
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  initiative              Initiative                       @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  organization            Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
