generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

enum ResourceType {
  PERSON
  OTHER
}

enum ScopeType {
  ORGANIZATION
  SECTION
  DEPARTMENT
  TEAM
  PLATFORM
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  description String?      @db.VarChar(2000)
  status      EntityStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sections     Section[]
  resources    Resource[]
  roleBindings RoleBinding[]
  auditEvents  AuditEvent[]
  initiatives  Initiative[]
  referenceCounter InitiativeReferenceCounter?

  @@index([status])
  @@map("organizations")
}

model Section {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(200)
  description    String?      @db.VarChar(2000)
  status         EntityStatus @default(ACTIVE)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departments  Department[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("sections")
}

model Department {
  id        String       @id @default(uuid()) @db.Uuid
  sectionId String       @db.Uuid
  name      String       @db.VarChar(200)
  description String?    @db.VarChar(2000)
  status    EntityStatus @default(ACTIVE)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  teams       Team[]
  initiatives Initiative[]

  @@unique([sectionId, name])
  @@index([sectionId, status])
  @@map("departments")
}

model Team {
  id           String       @id @default(uuid()) @db.Uuid
  departmentId String       @db.Uuid
  name         String       @db.VarChar(200)
  description  String?      @db.VarChar(2000)
  status       EntityStatus @default(ACTIVE)
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department  Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  memberships ResourceMembership[]

  @@unique([departmentId, name])
  @@index([departmentId, status])
  @@map("teams")
}

/// Capacity-bearing entity. Not the same as an authenticated Principal/User.
model Resource {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  name             String       @db.VarChar(200)
  referenceCode    String?      @db.VarChar(100)
  type             ResourceType @default(PERSON)
  functionRole     String?      @db.VarChar(200)
  skillsJson       Json         @default("[]")
  capacityHoursPerWeek Decimal? @db.Decimal(6, 2)
  status           EntityStatus @default(ACTIVE)
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  ResourceMembership[]

  @@unique([organizationId, referenceCode])
  @@index([organizationId, status])
  @@map("resources")
}

/// Explicit membership enables future multi-team membership without embedding a single teamId on Resource.
model ResourceMembership {
  id            String    @id @default(uuid()) @db.Uuid
  resourceId    String    @db.Uuid
  teamId        String    @db.Uuid
  isPrimary     Boolean   @default(false)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([resourceId])
  @@index([teamId])
  @@map("resource_memberships")
}

model Principal {
  id          String   @id @default(uuid()) @db.Uuid
  externalSubject String? @unique @db.VarChar(255)
  displayName String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleBindings RoleBinding[]

  @@map("principals")
}

model RoleDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(2000)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bindings RoleBinding[]

  @@map("role_definitions")
}

model RoleBinding {
  id               String    @id @default(uuid()) @db.Uuid
  principalId      String    @db.Uuid
  roleDefinitionId String    @db.Uuid
  scopeType        ScopeType
  organizationId   String?   @db.Uuid
  scopeId          String?   @db.Uuid
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  principal      Principal      @relation(fields: [principalId], references: [id], onDelete: Cascade)
  roleDefinition RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([principalId])
  @@index([organizationId, scopeType])
  @@map("role_bindings")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  occurredAt     DateTime @default(now())
  actorPrincipalId String? @db.Uuid
  actionType     String   @db.VarChar(100)
  subjectType    String   @db.VarChar(100)
  subjectId      String?  @db.Uuid
  organizationId String?  @db.Uuid
  correlationId  String?  @db.Uuid
  payload        Json
  result         String   @db.VarChar(40)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([organizationId, actionType])
  @@index([subjectType, subjectId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Phase 2 — Initiative lifecycle (Demand → Requirements → Pre-study)
// ---------------------------------------------------------------------------

enum InitiativeStage {
  DEMAND
  REQUIREMENTS
  PRE_STUDY
  POC
}

enum InitiativeStatus {
  ACTIVE
  ON_HOLD
  CANCELLED
  ARCHIVED
}

enum DemandUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementCategory {
  BUSINESS
  FUNCTIONAL
  NON_FUNCTIONAL
  ARCHITECTURE
  SECURITY
  INTEGRATION
  DATA
  COMPLIANCE
  OTHER
}

enum RequirementPriority {
  MUST
  SHOULD
  COULD
  WONT
}

enum RequirementStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  DEFERRED
  REJECTED
}

enum RequirementRelationType {
  DEPENDS_ON
  RELATED_TO
  REFINES
  CONFLICTS_WITH
}

enum AssessmentArea {
  BUSINESS
  CURRENT_STATE
  ARCHITECTURE
  SECURITY
  INTEGRATION
  DATA
  COST
  RESOURCES
  RISK
  OTHER
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
}

enum RiskImpact {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  MITIGATING
  ACCEPTED
  CLOSED
}

enum DocumentLifecycleStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUPERSEDED
}

/// Concurrency-safe per-organization sequence for human-readable initiative references.
model InitiativeReferenceCounter {
  organizationId String @id @db.Uuid
  nextValue      Int    @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("initiative_reference_counters")
}

/// Durable lifecycle root. Demand/Requirements/Pre-study are stage data, not separate apps.
model Initiative {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  departmentId       String           @db.Uuid
  referenceKey       String           @db.VarChar(40)
  title              String           @db.VarChar(300)
  /// Free-text business person reference — not a Principal or Resource FK.
  requesterName      String           @db.VarChar(200)
  requesterContact   String?          @db.VarChar(300)
  /// Free-text business owner reference — not a Principal or Resource FK.
  businessOwnerName  String           @db.VarChar(200)
  businessOwnerContact String?        @db.VarChar(300)
  currentStage       InitiativeStage  @default(DEMAND)
  status             InitiativeStatus @default(ACTIVE)
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  demand              Demand?
  requirements        Requirement[]
  preStudy            PreStudy?
  risks               Risk[]
  documents           ManagedDocument[]
  lifecycleTransitions LifecycleTransition[]

  // Phase 3 — Governance + Approvals + Decisions + PoC
  governanceGates            GovernanceGate[]
  governanceSubmissions      GovernanceSubmission[]
  reviewSnapshots            ReviewSnapshot[]
  decisions                  DecisionRecord[]
  poc                        PoC?
  requirementReferenceCounter RequirementReferenceCounter?
  riskReferenceCounter       RiskReferenceCounter?

  @@unique([organizationId, referenceKey])
  @@index([organizationId, currentStage, status])
  @@index([departmentId])
  @@map("initiatives")
}

model LifecycleTransition {
  id               String          @id @default(uuid()) @db.Uuid
  initiativeId     String          @db.Uuid
  fromStage        InitiativeStage
  toStage          InitiativeStage
  actorPrincipalId String?         @db.Uuid
  comment          String?         @db.VarChar(2000)
  occurredAt       DateTime        @default(now())

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@index([initiativeId, occurredAt])
  @@map("lifecycle_transitions")
}

model Demand {
  id                 String        @id @default(uuid()) @db.Uuid
  initiativeId       String        @unique @db.Uuid
  problemOpportunity String        @db.VarChar(4000)
  reasonForRequest   String        @db.VarChar(4000)
  expectedValue      String        @db.VarChar(4000)
  affectedAreas      String        @db.VarChar(2000)
  urgency            DemandUrgency @default(MEDIUM)
  strategicAlignment String        @db.VarChar(2000)
  initialImpact      String        @db.VarChar(2000)
  notes              String?       @db.VarChar(4000)
  version            Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@map("demands")
}

model Requirement {
  id             String              @id @default(uuid()) @db.Uuid
  initiativeId   String              @db.Uuid
  referenceKey   String              @db.VarChar(40)
  title          String              @db.VarChar(300)
  description    String              @db.VarChar(8000)
  category       RequirementCategory
  priority       RequirementPriority @default(SHOULD)
  ownerName      String?             @db.VarChar(200)
  source         String?             @db.VarChar(500)
  status         RequirementStatus   @default(DRAFT)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  initiative         Initiative              @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  acceptanceCriteria AcceptanceCriterion[]
  relationsFrom      RequirementRelation[]   @relation("RequirementRelationFrom")
  relationsTo        RequirementRelation[]   @relation("RequirementRelationTo")

  @@unique([initiativeId, referenceKey])
  @@index([initiativeId, status])
  @@map("requirements")
}

model AcceptanceCriterion {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @db.Uuid
  description   String   @db.VarChar(2000)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId, sortOrder])
  @@map("acceptance_criteria")
}

model RequirementRelation {
  id                   String                  @id @default(uuid()) @db.Uuid
  fromRequirementId    String                  @db.Uuid
  toRequirementId      String                  @db.Uuid
  relationType         RequirementRelationType
  createdAt            DateTime                @default(now())

  fromRequirement Requirement @relation("RequirementRelationFrom", fields: [fromRequirementId], references: [id], onDelete: Cascade)
  toRequirement   Requirement @relation("RequirementRelationTo", fields: [toRequirementId], references: [id], onDelete: Cascade)

  @@unique([fromRequirementId, toRequirementId, relationType])
  @@index([toRequirementId])
  @@map("requirement_relations")
}

model PreStudy {
  id           String   @id @default(uuid()) @db.Uuid
  initiativeId String   @unique @db.Uuid
  summary      String?  @db.VarChar(4000)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  initiative   Initiative              @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  assessments  PreStudyAssessment[]
  alternatives SolutionAlternative[]

  @@map("pre_studies")
}

model PreStudyAssessment {
  id          String           @id @default(uuid()) @db.Uuid
  preStudyId  String           @db.Uuid
  area        AssessmentArea
  ownerName   String?          @db.VarChar(200)
  status      AssessmentStatus @default(NOT_STARTED)
  summary     String?          @db.VarChar(4000)
  findings    String?          @db.VarChar(8000)
  conclusion  String?          @db.VarChar(4000)
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  preStudy PreStudy @relation(fields: [preStudyId], references: [id], onDelete: Cascade)

  @@unique([preStudyId, area])
  @@index([preStudyId, status])
  @@map("pre_study_assessments")
}

model SolutionAlternative {
  id                 String   @id @default(uuid()) @db.Uuid
  preStudyId         String   @db.Uuid
  title              String   @db.VarChar(300)
  description        String   @db.VarChar(4000)
  benefits           String?  @db.VarChar(4000)
  drawbacks          String?  @db.VarChar(4000)
  estimatedCost      String?  @db.VarChar(500)
  estimatedDuration  String?  @db.VarChar(200)
  riskUncertainty    String?  @db.VarChar(2000)
  notes              String?  @db.VarChar(4000)
  /// Recommendation indicator only — NEVER an automatic governance decision.
  isRecommended      Boolean  @default(false)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  preStudy PreStudy @relation(fields: [preStudyId], references: [id], onDelete: Cascade)

  @@index([preStudyId])
  @@map("solution_alternatives")
}

/// Canonical risk — reusable beyond Pre-study; not a PreStudyRisk fork.
model Risk {
  id             String          @id @default(uuid()) @db.Uuid
  initiativeId   String          @db.Uuid
  referenceKey   String          @db.VarChar(40)
  title          String          @db.VarChar(300)
  description    String          @db.VarChar(4000)
  ownerName      String?         @db.VarChar(200)
  probability    RiskProbability @default(MEDIUM)
  impact         RiskImpact      @default(MEDIUM)
  status         RiskStatus      @default(OPEN)
  mitigation     String?         @db.VarChar(4000)
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, referenceKey])
  @@index([initiativeId, status])
  @@map("risks")
}

/// Document metadata foundation — binary upload deferred (no blobs in PostgreSQL).
model ManagedDocument {
  id           String   @id @default(uuid()) @db.Uuid
  initiativeId String   @db.Uuid
  title        String   @db.VarChar(300)
  category     String   @db.VarChar(100)
  ownerName    String?  @db.VarChar(200)
  stage        InitiativeStage?
  assessmentArea AssessmentArea?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  initiative Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  versions   DocumentVersion[]

  @@index([initiativeId])
  @@map("managed_documents")
}

model DocumentVersion {
  id               String                  @id @default(uuid()) @db.Uuid
  documentId       String                  @db.Uuid
  versionLabel     String                  @db.VarChar(40)
  lifecycleStatus  DocumentLifecycleStatus @default(DRAFT)
  /// Placeholder for future object-storage pointer — not a binary payload.
  storagePointer   String?                 @db.VarChar(1000)
  changeSummary    String?                 @db.VarChar(2000)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  document ManagedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionLabel])
  @@index([documentId])
  @@map("document_versions")
}

// ---------------------------------------------------------------------------
// Phase 3 — Governance + Approvals + Decisions + PoC
// ---------------------------------------------------------------------------

enum GateType {
  PRE_STUDY_GATE
  POC_GATE
}

enum GovernanceSubmissionStatus {
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVALS_COMPLETE
  DECISION_RECORDED
  SUPERSEDED
  CANCELLED
}

enum ApprovalRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ApprovalOutcome {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum DecisionOutcome {
  GO
  CONDITIONAL_GO
  NO_GO
  HOLD
}

enum DecisionConditionStatus {
  OPEN
  RESOLVED
  WAIVED
  CANCELLED
}

enum PoCStatus {
  DRAFT
  READY
  IN_PROGRESS
  EVALUATION
  COMPLETED
}

enum CriterionEvaluationState {
  NOT_EVALUATED
  PASS
  FAIL
  INCONCLUSIVE
}

enum EvidenceEntryKind {
  DOCUMENT_VERSION
  REQUIREMENT
  ASSESSMENT
  RISK
  ALTERNATIVE
  POC_RESULT
  READINESS_SUMMARY
  OTHER
}

enum EvidenceRequirementLevel {
  REQUIRED
  OPTIONAL
}

/// Concurrency-safe per-initiative sequence for REQ-### references.
model RequirementReferenceCounter {
  initiativeId String @id @db.Uuid
  nextValue    Int    @default(1)

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@map("requirement_reference_counters")
}

/// Concurrency-safe per-initiative sequence for RSK-### references.
model RiskReferenceCounter {
  initiativeId String @id @db.Uuid
  nextValue    Int    @default(1)

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@map("risk_reference_counters")
}

/// One durable gate row per initiative+gateType; submissions accumulate on the gate.
model GovernanceGate {
  id           String          @id @default(uuid()) @db.Uuid
  initiativeId String          @db.Uuid
  gateType     GateType
  stage        InitiativeStage
  /// OPEN | IN_PROGRESS | DECIDED | CLOSED
  status       String          @default("OPEN") @db.VarChar(40)
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  initiative  Initiative             @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  submissions GovernanceSubmission[]
  evidencePackages EvidencePackage[]
  decisionPackages DecisionPackage[]
  decisions   DecisionRecord[]

  @@unique([initiativeId, gateType])
  @@index([initiativeId, status])
  @@map("governance_gates")
}

model GovernanceSubmission {
  id                      String                      @id @default(uuid()) @db.Uuid
  gateId                  String                      @db.Uuid
  initiativeId            String                      @db.Uuid
  revision                Int
  status                  GovernanceSubmissionStatus  @default(SUBMITTED)
  submittedByPrincipalId  String                      @db.Uuid
  submittedAt             DateTime                    @default(now())
  reviewSnapshotId        String                      @db.Uuid
  version                 Int                         @default(1)
  supersededBySubmissionId String?                    @db.Uuid
  previousSubmissionId    String?                     @db.Uuid
  notes                   String?                     @db.VarChar(4000)

  gate             GovernanceGate  @relation(fields: [gateId], references: [id], onDelete: Cascade)
  initiative       Initiative      @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  reviewSnapshot   ReviewSnapshot  @relation(fields: [reviewSnapshotId], references: [id], onDelete: Restrict)
  supersededBy     GovernanceSubmission?  @relation("SubmissionSupersession", fields: [supersededBySubmissionId], references: [id], onDelete: SetNull)
  supersedes       GovernanceSubmission[] @relation("SubmissionSupersession")
  previous         GovernanceSubmission?  @relation("SubmissionRevisionChain", fields: [previousSubmissionId], references: [id], onDelete: SetNull)
  nextRevisions    GovernanceSubmission[] @relation("SubmissionRevisionChain")
  evidencePackage  EvidencePackage?
  approvalRequests ApprovalRequest[]
  decisionPackage  DecisionPackage?
  decisionRecord   DecisionRecord?

  @@unique([gateId, revision])
  @@index([initiativeId, status])
  @@index([reviewSnapshotId])
  @@map("governance_submissions")
}

/// Immutable frozen workspace payload for a governance revision.
model ReviewSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  initiativeId String   @db.Uuid
  gateType     GateType
  revision     Int
  payload      Json
  createdAt    DateTime @default(now())

  initiative  Initiative             @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  submissions GovernanceSubmission[]
  approvalRequests ApprovalRequest[]
  approvalRecords  ApprovalRecord[]
  decisions        DecisionRecord[]

  @@index([initiativeId, gateType, revision])
  @@map("review_snapshots")
}

model EvidencePackage {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @unique @db.Uuid
  gateId       String   @db.Uuid
  version      Int      @default(1)
  createdAt    DateTime @default(now())

  submission GovernanceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gate       GovernanceGate       @relation(fields: [gateId], references: [id], onDelete: Cascade)
  entries    EvidenceEntry[]
  decisions  DecisionRecord[]

  @@index([gateId])
  @@map("evidence_packages")
}

model EvidenceEntry {
  id               String                   @id @default(uuid()) @db.Uuid
  packageId        String                   @db.Uuid
  kind             EvidenceEntryKind
  requirementLevel EvidenceRequirementLevel @default(REQUIRED)
  label            String                   @db.VarChar(300)
  present          Boolean                  @default(false)
  referenceType    String?                  @db.VarChar(100)
  referenceId      String?                  @db.Uuid
  snapshotBinding  Json?
  sortOrder        Int                      @default(0)

  package EvidencePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
  @@map("evidence_entries")
}

/// Bootstrap / central policy templates — org-specific matrices stay data-driven.
model ApprovalRequirementTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  gateType           GateType
  /// e.g. business | architecture | security
  authorityKey       String   @db.VarChar(100)
  requiredPermission String   @db.VarChar(200)
  label              String   @db.VarChar(300)
  required           Boolean  @default(true)
  sortOrder          Int      @default(0)
  conditionNote      String?  @db.VarChar(2000)
  active             Boolean  @default(true)

  approvalRequests ApprovalRequest[]

  @@unique([gateType, authorityKey])
  @@index([gateType, active])
  @@map("approval_requirement_templates")
}

model ApprovalRequest {
  id                   String                @id @default(uuid()) @db.Uuid
  submissionId         String                @db.Uuid
  requirementTemplateId String?              @db.Uuid
  authorityKey         String                @db.VarChar(100)
  requiredPermission   String                @db.VarChar(200)
  label                String                @db.VarChar(300)
  status               ApprovalRequestStatus @default(PENDING)
  assignedPrincipalId  String?               @db.Uuid
  requestedAt          DateTime              @default(now())
  reviewSnapshotId     String                @db.Uuid
  version              Int                   @default(1)
  completedAt          DateTime?

  submission          GovernanceSubmission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requirementTemplate ApprovalRequirementTemplate? @relation(fields: [requirementTemplateId], references: [id], onDelete: SetNull)
  reviewSnapshot      ReviewSnapshot               @relation(fields: [reviewSnapshotId], references: [id], onDelete: Restrict)
  record              ApprovalRecord?

  @@index([submissionId, status])
  @@index([reviewSnapshotId])
  @@map("approval_requests")
}

/// Immutable approval outcome — one record per completed request for MVP.
model ApprovalRecord {
  id                 String          @id @default(uuid()) @db.Uuid
  approvalRequestId  String          @unique @db.Uuid
  approverPrincipalId String         @db.Uuid
  outcome            ApprovalOutcome
  comment            String?         @db.VarChar(4000)
  conditionsText     String?         @db.VarChar(4000)
  reviewSnapshotId   String          @db.Uuid
  decidedAt          DateTime        @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  reviewSnapshot  ReviewSnapshot  @relation(fields: [reviewSnapshotId], references: [id], onDelete: Restrict)

  @@index([reviewSnapshotId])
  @@map("approval_records")
}

model DecisionPackage {
  id                         String   @id @default(uuid()) @db.Uuid
  submissionId               String   @unique @db.Uuid
  gateId                     String   @db.Uuid
  initiativeId               String   @db.Uuid
  question                   String   @db.VarChar(2000)
  whyNeeded                  String   @db.VarChar(4000)
  /// Recommendation only — NEVER auto-copied into DecisionRecord.outcome.
  recommendationText         String?  @db.VarChar(4000)
  recommendationAlternativeId String? @db.Uuid
  version                    Int      @default(1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  submission GovernanceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gate       GovernanceGate       @relation(fields: [gateId], references: [id], onDelete: Cascade)
  decision   DecisionRecord?

  @@index([initiativeId])
  @@index([gateId])
  @@map("decision_packages")
}

/// Immutable governance decision — recommendation ≠ decision.
model DecisionRecord {
  id                      String          @id @default(uuid()) @db.Uuid
  referenceKey            String          @db.VarChar(40)
  gateId                  String          @db.Uuid
  submissionId            String          @unique @db.Uuid
  decisionPackageId       String          @unique @db.Uuid
  initiativeId            String          @db.Uuid
  question                String          @db.VarChar(2000)
  optionsConsidered       Json
  recommendationText      String?         @db.VarChar(4000)
  outcome                 DecisionOutcome
  rationale               String          @db.VarChar(8000)
  decisionMakerPrincipalId String         @db.Uuid
  decidedAt               DateTime        @default(now())
  reviewSnapshotId        String          @db.Uuid
  evidencePackageId       String          @db.Uuid
  supersedesDecisionId    String?         @db.Uuid
  /// Concurrency token at create-time only — records are immutable after insert.
  version                 Int             @default(1)

  gate             GovernanceGate       @relation(fields: [gateId], references: [id], onDelete: Restrict)
  submission       GovernanceSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  decisionPackage  DecisionPackage      @relation(fields: [decisionPackageId], references: [id], onDelete: Restrict)
  initiative       Initiative           @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  reviewSnapshot   ReviewSnapshot       @relation(fields: [reviewSnapshotId], references: [id], onDelete: Restrict)
  evidencePackage  EvidencePackage      @relation(fields: [evidencePackageId], references: [id], onDelete: Restrict)
  supersedes       DecisionRecord?      @relation("DecisionSupersession", fields: [supersedesDecisionId], references: [id], onDelete: SetNull)
  supersededBy     DecisionRecord[]     @relation("DecisionSupersession")
  conditions       DecisionCondition[]

  @@unique([initiativeId, referenceKey])
  @@index([gateId])
  @@index([initiativeId, outcome])
  @@map("decision_records")
}

model DecisionCondition {
  id                        String                  @id @default(uuid()) @db.Uuid
  decisionId                String                  @db.Uuid
  description               String                  @db.VarChar(4000)
  ownerName                 String?                 @db.VarChar(200)
  dueDate                   DateTime?
  status                    DecisionConditionStatus @default(OPEN)
  requiredBeforeProgression Boolean                 @default(true)
  resolvedAt                DateTime?
  resolutionNote            String?                 @db.VarChar(4000)
  version                   Int                     @default(1)

  decision DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, status])
  @@map("decision_conditions")
}

model PoC {
  id                   String    @id @default(uuid()) @db.Uuid
  initiativeId         String    @unique @db.Uuid
  title                String    @db.VarChar(300)
  objective            String    @db.VarChar(4000)
  hypothesis           String    @db.VarChar(4000)
  scope                String    @db.VarChar(4000)
  outOfScope           String?   @db.VarChar(4000)
  ownerName            String?   @db.VarChar(200)
  plannedStart         DateTime?
  plannedEnd           DateTime?
  estimatedCost        String?   @db.VarChar(500)
  resourceNotes        String?   @db.VarChar(4000)
  technicalConstraints String?   @db.VarChar(4000)
  dependencyNotes      String?   @db.VarChar(4000)
  results              String?   @db.VarChar(8000)
  findings             String?   @db.VarChar(8000)
  lessonsLearned       String?   @db.VarChar(8000)
  actualCost           String?   @db.VarChar(500)
  actualStart          DateTime?
  actualEnd            DateTime?
  status               PoCStatus @default(DRAFT)
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  initiative Initiative           @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  criteria   PoCSuccessCriterion[]

  @@index([status])
  @@map("pocs")
}

model PoCSuccessCriterion {
  id                String                    @id @default(uuid()) @db.Uuid
  pocId             String                    @db.Uuid
  description       String                    @db.VarChar(2000)
  measurementMethod String                    @db.VarChar(2000)
  target            String                    @db.VarChar(1000)
  unit              String?                   @db.VarChar(100)
  required          Boolean                   @default(true)
  sortOrder         Int                       @default(0)
  evaluationState   CriterionEvaluationState  @default(NOT_EVALUATED)
  actualResult      String?                   @db.VarChar(2000)
  evidenceReference String?                   @db.VarChar(1000)
  evaluationNotes   String?                   @db.VarChar(4000)
  evaluatedAt       DateTime?
  version           Int                       @default(1)

  poc PoC @relation(fields: [pocId], references: [id], onDelete: Cascade)

  @@index([pocId, sortOrder])
  @@map("poc_success_criteria")
}
