  scope                   String      @db.VarChar(4000)
  outOfScope              String?     @db.VarChar(4000)
  /// Free-text business person — not a Principal FK.
  ownerName               String?     @db.VarChar(200)
  siteOrArea              String?     @db.VarChar(1000)
  targetUsers             String?     @db.VarChar(2000)
  plannedStart            DateTime?
  plannedEnd              DateTime?
  actualStart             DateTime?
  actualEnd               DateTime?
  estimatedCost           Decimal?    @db.Decimal(18, 2)
  actualCost              Decimal?    @db.Decimal(18, 2)
  currencyCode            String      @default("EUR") @db.VarChar(3)
  resourceNotes           String?     @db.VarChar(4000)
  environment             String?     @db.VarChar(2000)
  operationalConstraints  String?     @db.VarChar(4000)
  supportModel            String?     @db.VarChar(4000)
  rollbackPlan            String?     @db.VarChar(4000)
  results                 String?     @db.VarChar(8000)
  businessFindings        String?     @db.VarChar(8000)
  technicalFindings       String?     @db.VarChar(8000)
